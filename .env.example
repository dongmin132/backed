# Copy to .env (git-ignored) or export these in your shell.

# PayPal sandbox REST app credentials (developer.paypal.com, Apps and Credentials, Sandbox).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Claude API key for the AI investigator. Optional: without it the rest of the app works.
ANTHROPIC_API_KEY=

# Optional. Model for the investigator (default claude-opus-5-5).
# BACKED_AI_MODEL=claude-opus-5-5

# Optional. Sandbox test card for top-ups. The default is the generic Visa test number; to use a
# card from the PayPal sandbox card generator, set these. Expiry is YYYY-MM.
# BACKED_TEST_CARD_NUMBER=
# BACKED_TEST_CARD_EXPIRY=
# BACKED_TEST_CARD_CVV=

# Optional. Use your own PostgreSQL instead of the embedded one.
# BACKED_DB_URL=jdbc:postgresql://localhost:5432/backed
# BACKED_DB_USER=
# BACKED_DB_PASSWORD=

# Optional. Webhook signature verification (off by default).
# PAYPAL_WEBHOOK_ID=
# backed.webhooks.verify-signature=true
